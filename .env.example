# Open Cloud API key, created in the Creator Hub. Playtests need the legacy-asset:manage scope. Cloud tests also need permission to publish place versions and to run Luau execution on the test universe.
ROBLOX_API_KEY=

# Id of a place of yours to run the playtests in. mise run playtest downloads its last saved version, merges the project into it and plays it. Nothing is saved back.
ROBLOX_PLAYTEST_PLACE_ID=

# Id of a test universe. Only mise run test with the cloud flag and the CI test job use it. The CI test job is skipped while this is empty.
ROBLOX_TEST_UNIVERSE_ID=

# Id of a place inside that test universe, where the cloud tests are published and run.
ROBLOX_TEST_PLACE_ID=
