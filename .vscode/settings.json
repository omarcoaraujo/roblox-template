{
    "charmed-icons.associations.folders": {
        "loading": "folder_client",
        "network": "folder_event",
        "migrations": "folder_config",
        "stores": "folder_database",
        "definitions": "folder_function",
        "playtests": "folder_test",
        "specs": "folder_test",
        "helpers": "folder_util"
    },
    
    "[luau]": {
        "editor.foldingImportsByDefault": false,
        "editor.showFoldingControls": "always",
        "editor.foldingStrategy": "indentation",
        "editor.unfoldOnClickAfterEndOfLine": false,
        "editor.defaultFormatter": "JohnnyMorganz.stylua"
    },

    "stylua.targetReleaseVersion": "latest",
    "luau-lsp.sourcemap.rojoProjectFile": "dev.project.json",
    "luau-lsp.platform.type": "roblox",
    "luau-lsp.completion.imports.stringRequires.enabled": true,
    "files.exclude": {
        "**/*_packages": true,
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/.DS_Store": true,
        "**/Thumbs.db": true
    },
    "hide-files.files": [],
}